{
  "name": "auratickets-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AuraTickets High-Concurrency Ticket Booking Platform",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "share": "npx localtunnel --port 3000",
    "share:localtunnel": "npx localtunnel --port 3000",
    "share:pinggy": "ssh -p 443 -R0:localhost:3000 a.pinggy.io"
  }
}

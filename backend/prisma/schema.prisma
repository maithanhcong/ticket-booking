generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum UserRole {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// ---------------------------------------------------------
// MODELS
// ---------------------------------------------------------

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @db.VarChar(255)
  firstName    String        @db.VarChar(100)
  lastName     String        @db.VarChar(100)
  role         UserRole      @default(CUSTOMER)
  balance      Float         @default(1000.0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  bookings     Booking[]
  lockedSeats  Seat[]        @relation("SeatLockedByUser")
}

model Venue {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  address   String    @db.VarChar(500)
  city      String    @db.VarChar(100)
  country   String    @db.VarChar(100)
  timezone  String    @default("UTC") @db.VarChar(50)
  capacity  Int
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  sections  Section[]
  events    Event[]

  @@index([city])
  @@index([slug])
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @db.Uuid
  name      String   @db.VarChar(100)
  capacity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats     Seat[]

  @@unique([venueId, name], name: "unique_section_per_venue")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  venueId     String   @db.Uuid
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String   @db.Text
  startTime   DateTime @db.Timestamptz(6)
  endTime     DateTime @db.Timestamptz(6)
  bannerUrl   String?  @db.VarChar(1024)
  isPublished Boolean  @default(false)

  // ---------------------------------------------------------------------------
  // PGVECTOR EMBEDDING (1536-dim e.g., OpenAI text-embedding-3-small / ada-002)
  // Requires raw SQL migration: CREATE EXTENSION IF NOT EXISTS vector;
  // HNSW Index: CREATE INDEX event_embedding_hnsw_idx ON "Event" USING hnsw (embedding vector_cosine_ops);
  // ---------------------------------------------------------------------------
  embedding   Unsupported("vector(1536)")?

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  seats       Seat[]
  bookings    Booking[]

  @@index([venueId])
  @@index([startTime])
  @@index([isPublished, startTime])
  @@index([isPublished])
}

model Seat {
  id             String     @id @default(uuid()) @db.Uuid
  eventId        String     @db.Uuid
  sectionId      String     @db.Uuid
  row            String     @db.VarChar(20)
  seatNumber     String     @db.VarChar(20)
  price          Decimal    @db.Decimal(10, 2)
  status         SeatStatus @default(AVAILABLE)

  // High-concurrency optimistic lock version
  version        Int        @default(0)

  // Distributed lock lease timestamp and holder
  lockedUntil    DateTime?  @db.Timestamptz(6)
  lockedByUserId String?    @db.Uuid

  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section        Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  lockedByUser   User?         @relation("SeatLockedByUser", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  bookingItems   BookingItem[]

  // Invariant: unique seat per section and row within an event
  @@unique([eventId, sectionId, row, seatNumber], name: "unique_seat_per_event_section")
  @@index([eventId, status])
  @@index([lockedUntil])
  @@index([sectionId])
  @@index([lockedByUserId])
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  bookingReference String        @unique @db.VarChar(32)
  userId           String        @db.Uuid
  eventId          String        @db.Uuid
  status           BookingStatus @default(PENDING)
  totalAmount      Decimal       @db.Decimal(10, 2)

  // Idempotency key for payment processing and distributed lock safety
  idempotencyKey   String?       @unique @db.VarChar(128)

  // Reservation lock expiration countdown
  expiresAt        DateTime      @db.Timestamptz(6)

  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items            BookingItem[]

  @@index([userId, status])
  @@index([eventId, status])
  @@index([expiresAt])
}

model BookingItem {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  seatId    String   @db.Uuid
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, seatId], name: "unique_booking_seat_item")
  @@index([seatId])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(100)
  eventType     String       @db.VarChar(100)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  lastError     String?      @db.Text
  scheduledAt   DateTime     @default(now()) @db.Timestamptz(6)
  processedAt   DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  // Critical for polling high-throughput outbox dispatchers
  @@index([status, scheduledAt], name: "idx_outbox_status_scheduled")
  @@index([aggregateType, aggregateId], name: "idx_outbox_aggregate")
}

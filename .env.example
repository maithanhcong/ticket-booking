# ==============================================================================
# TICKET BOOKING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (PostgreSQL 16 with pgvector)
POSTGRES_USER=ticket_admin
POSTGRES_PASSWORD=ticket_secure_password
POSTGRES_DB=ticket_booking_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ticket_admin:ticket_secure_password@localhost:5432/ticket_booking_db?schema=public

# Redis 7 (Distributed Locks & Atomic Seat Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@localhost:6379

# RabbitMQ 3.12 (Message Broker & Async Booking Workers)
RABBITMQ_USER=ticket_mq_admin
RABBITMQ_PASSWORD=ticket_mq_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://ticket_mq_admin:ticket_mq_password@localhost:5672

# Backend (NestJS)
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secure_jwt_access_token_secret_key_change_in_prod
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secure_jwt_refresh_token_secret_key_change_in_prod
JWT_REFRESH_EXPIRATION=7d
SEAT_LOCK_TTL_SECONDS=600

# OpenAI API (pgvector 1536-dimensional embeddings for Semantic Event Search)
OPENAI_API_KEY=sk-proj-placeholder-replace-with-real-key

# Google Generative AI (Gemini 2.5 Flash & text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend (Next.js 14+)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
